diff --git a/src/gallium/drivers/grate/grate_wlr.c b/src/gallium/drivers/grate/grate_wlr.c
new file mode 100644
index 0000000..8ccc478
--- /dev/null
+++ b/src/gallium/drivers/grate/grate_wlr.c
@@ -0,0 +1,290 @@
+#include <stdio.h>
+#include <math.h>
+
+#include "tgsi/tgsi_parse.h"
+#include "util/u_math.h"
+
+#include "grate_common.h"
+#include "grate_context.h"
+#include "grate_program.h"
+#include "grate_resource.h"
+#include "grate_wlr.h"
+
+#include "tgr_3d.xml.h"
+#include "host1x01_hardware.h"
+
+/*
+ * What the generated wlr_programs.h expects from opentegra's gr3d.h; as
+ * host1x_opcode_*(), but usable in static initializers.
+ */
+#define HOST1X_OPCODE_INCR(offset, count)    ((1u << 28) | ((offset) << 16) | (count))
+#define HOST1X_OPCODE_NONINCR(offset, count) ((2u << 28) | ((offset) << 16) | (count))
+#define HOST1X_OPCODE_IMM(offset, data)      ((4u << 28) | ((offset) << 16) | (data))
+#define TEGRA_ARRAY_SIZE(x) ARRAY_SIZE(x)
+
+struct shader_program {
+   const uint32_t *fs_prog_words;
+   const unsigned fs_prog_words_nb;
+   const unsigned fs_alu_buf_size;
+   const unsigned fs_pseq_to_dw;
+   const unsigned fs_pseq_inst_nb;
+
+   const uint32_t *linker_words;
+   const unsigned linker_words_nb;
+   const unsigned linker_inst_nb;
+   const unsigned used_tram_rows_nb;
+
+   const char *name;
+};
+
+#include "fp/wlr/wlr_programs.h"
+
+static bool
+is_const0(const struct tgsi_full_src_register *src)
+{
+   return src->Register.File == TGSI_FILE_CONSTANT &&
+          src->Register.Index == 0 && !src->Register.Indirect;
+}
+
+static bool
+is_tex_input0(const struct tgsi_full_instruction *inst)
+{
+   return inst->Instruction.Opcode == TGSI_OPCODE_TEX &&
+          inst->Texture.Texture == TGSI_TEXTURE_2D &&
+          inst->Src[0].Register.File == TGSI_FILE_INPUT &&
+          inst->Src[0].Register.Index == 0 &&
+          inst->Src[1].Register.File == TGSI_FILE_SAMPLER &&
+          inst->Src[1].Register.Index == 0;
+}
+
+static bool
+is_mul_alpha_out(const struct tgsi_full_instruction *inst)
+{
+   const struct tgsi_src_register *a = &inst->Src[1].Register;
+
+   return inst->Instruction.Opcode == TGSI_OPCODE_MUL &&
+          inst->Dst[0].Register.File == TGSI_FILE_OUTPUT &&
+          inst->Dst[0].Register.WriteMask == TGSI_WRITEMASK_XYZW &&
+          is_const0(&inst->Src[1]) &&
+          a->SwizzleX == TGSI_SWIZZLE_X && a->SwizzleY == TGSI_SWIZZLE_X &&
+          a->SwizzleZ == TGSI_SWIZZLE_X && a->SwizzleW == TGSI_SWIZZLE_X;
+}
+
+enum grate_wlr_fp
+grate_wlr_classify_fs(const struct tgsi_token *tokens)
+{
+   struct tgsi_full_instruction insts[4];
+   struct tgsi_parse_context parser;
+   unsigned n = 0;
+
+   if (tgsi_parse_init(&parser, tokens) != TGSI_PARSE_OK)
+      return GRATE_WLR_FP_NONE;
+
+   while (!tgsi_parse_end_of_tokens(&parser)) {
+      tgsi_parse_token(&parser);
+      if (parser.FullToken.Token.Type != TGSI_TOKEN_TYPE_INSTRUCTION ||
+          parser.FullToken.FullInstruction.Instruction.Opcode == TGSI_OPCODE_END)
+         continue;
+      if (n == ARRAY_SIZE(insts)) {
+         n++;
+         break;
+      }
+      insts[n++] = parser.FullToken.FullInstruction;
+   }
+   tgsi_parse_free(&parser);
+
+   if (n == 1 && insts[0].Instruction.Opcode == TGSI_OPCODE_MOV &&
+       insts[0].Dst[0].Register.File == TGSI_FILE_OUTPUT &&
+       insts[0].Dst[0].Register.WriteMask == TGSI_WRITEMASK_XYZW &&
+       is_const0(&insts[0].Src[0]) &&
+       insts[0].Src[0].Register.SwizzleX == TGSI_SWIZZLE_X &&
+       insts[0].Src[0].Register.SwizzleY == TGSI_SWIZZLE_Y &&
+       insts[0].Src[0].Register.SwizzleZ == TGSI_SWIZZLE_Z &&
+       insts[0].Src[0].Register.SwizzleW == TGSI_SWIZZLE_W)
+      return GRATE_WLR_FP_SOLID;
+
+   if (n == 2 && is_tex_input0(&insts[0]) && is_mul_alpha_out(&insts[1]))
+      return GRATE_WLR_FP_TEX;
+
+   /* TEX t; MOV t.xyz, t; MOV t.w, IMM(1.0); MUL OUT, t, CONST[0].xxxx */
+   if (n == 4 && is_tex_input0(&insts[0]) &&
+       insts[1].Instruction.Opcode == TGSI_OPCODE_MOV &&
+       insts[1].Dst[0].Register.WriteMask == TGSI_WRITEMASK_XYZ &&
+       insts[2].Instruction.Opcode == TGSI_OPCODE_MOV &&
+       insts[2].Dst[0].Register.WriteMask == TGSI_WRITEMASK_W &&
+       insts[2].Src[0].Register.File == TGSI_FILE_IMMEDIATE &&
+       is_mul_alpha_out(&insts[3]))
+      return GRATE_WLR_FP_TEX_RGBX;
+
+   return GRATE_WLR_FP_NONE;
+}
+
+/* fx10: 10-bit signed fixed point, 1.0 = 256 */
+static uint32_t
+fx10(float f)
+{
+   return (uint32_t)lrintf(CLAMP(f, -2.0f, 1.99609375f) * 256.0f) & 0x3ff;
+}
+
+static uint32_t
+fx10x2(float lo, float hi)
+{
+   return fx10(hi) << 10 | fx10(lo);
+}
+
+static bool
+blend_over(struct grate_context *context)
+{
+   static bool warned;
+   const struct pipe_rt_blend_state *rt;
+
+   if (!context->blend || !context->blend->rt[0].blend_enable)
+      return false;
+
+   rt = &context->blend->rt[0];
+   if (!warned &&
+       (rt->rgb_func != PIPE_BLEND_ADD ||
+        rt->rgb_src_factor != PIPE_BLENDFACTOR_ONE ||
+        rt->rgb_dst_factor != PIPE_BLENDFACTOR_INV_SRC_ALPHA)) {
+      fprintf(stderr, "grate: only premultiplied-over blending is "
+              "implemented, drawing other blend modes as it\n");
+      warned = true;
+   }
+
+   return true;
+}
+
+static void
+emit_texture(struct grate_context *context)
+{
+   struct grate_stream *stream = &context->gr3d->stream;
+   struct pipe_sampler_view *view = context->fragment_views[0];
+   const struct pipe_sampler_state *samp = context->fragment_samplers[0];
+   struct grate_resource *tex;
+   unsigned width, height;
+   uint32_t desc1, desc2;
+   bool min_linear = false, mag_linear = false, clamp = true, mirror = false;
+
+   if (!view || !view->texture)
+      return;
+
+   tex = grate_resource(view->texture);
+   width = view->texture->width0;
+   height = view->texture->height0;
+
+   if (samp) {
+      min_linear = samp->min_img_filter == PIPE_TEX_FILTER_LINEAR;
+      mag_linear = samp->mag_img_filter == PIPE_TEX_FILTER_LINEAR;
+      clamp = samp->wrap_s != PIPE_TEX_WRAP_REPEAT &&
+              samp->wrap_s != PIPE_TEX_WRAP_MIRROR_REPEAT;
+      mirror = samp->wrap_s == PIPE_TEX_WRAP_MIRROR_REPEAT;
+   }
+
+   desc1  = TGR3D_VAL(TEXTURE_DESC1, FORMAT, tex->format);
+   desc1 |= TGR3D_BOOL(TEXTURE_DESC1, MINFILTER_LINEAR_WITHIN, min_linear);
+   desc1 |= TGR3D_BOOL(TEXTURE_DESC1, MAGFILTER_LINEAR, mag_linear);
+   desc1 |= TGR3D_BOOL(TEXTURE_DESC1, WRAP_S_CLAMP_TO_EDGE, clamp);
+   desc1 |= TGR3D_BOOL(TEXTURE_DESC1, WRAP_T_CLAMP_TO_EDGE, clamp);
+   desc1 |= TGR3D_BOOL(TEXTURE_DESC1, WRAP_S_MIRRORED_REPEAT, mirror);
+   desc1 |= TGR3D_BOOL(TEXTURE_DESC1, WRAP_T_MIRRORED_REPEAT, mirror);
+
+   desc2 = TGR3D_BOOL(TEXTURE_DESC2, MIPMAP_DISABLE, 1);
+   if (util_is_power_of_two_nonzero(width) &&
+       util_is_power_of_two_nonzero(height)) {
+      desc2 |= TGR3D_VAL(TEXTURE_DESC2, WIDTH_LOG2, util_logbase2(width));
+      desc2 |= TGR3D_VAL(TEXTURE_DESC2, HEIGHT_LOG2, util_logbase2(height));
+   } else {
+      desc2 |= TGR3D_BOOL(TEXTURE_DESC2, NOT_POW2_DIMENSIONS, 1);
+      desc2 |= TGR3D_VAL(TEXTURE_DESC2, WIDTH, width);
+      desc2 |= TGR3D_VAL(TEXTURE_DESC2, HEIGHT, height);
+   }
+
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_TEXTURE_DESC1(0), 2));
+   grate_stream_push(stream, desc1);
+   grate_stream_push(stream, desc2);
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_TEXTURE_POINTER(0), 1));
+   grate_stream_push_reloc(stream, tex->bo, 0);
+}
+
+static void
+emit_uniforms(struct grate_context *context, enum grate_wlr_fp kind)
+{
+   struct grate_stream *stream = &context->gr3d->stream;
+   const struct pipe_constant_buffer *cb =
+      &context->constant_buffer[PIPE_SHADER_FRAGMENT];
+   const float *c = cb->user_buffer;
+   float zero[4] = { 0 };
+
+   if (!c || cb->buffer_size < 4 * sizeof(float))
+      c = zero;
+
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_FP_CONST(0), 3));
+   if (kind == GRATE_WLR_FP_SOLID) {
+      /* render targets are B8G8R8A8/X8: bytes b, g, r, a */
+      grate_stream_push(stream, fx10x2(c[2], c[1]));
+      grate_stream_push(stream, fx10x2(c[0], c[3]));
+      grate_stream_push(stream, 0);
+   } else {
+      grate_stream_push(stream, fx10x2(c[0], c[0]));
+      grate_stream_push(stream, fx10x2(c[0], c[0]));
+      grate_stream_push(stream, fx10x2(kind == GRATE_WLR_FP_TEX_RGBX, 0));
+   }
+}
+
+void
+grate_wlr_emit_program(struct grate_context *context)
+{
+   struct grate_stream *stream = &context->gr3d->stream;
+   enum grate_wlr_fp kind = context->fshader->wlr;
+   bool over = blend_over(context);
+   const struct shader_program *prog;
+   unsigned pseq_cfg = 0x12c;
+   uint32_t value;
+
+   if (kind == GRATE_WLR_FP_SOLID)
+      prog = over ? &prog_wlr_solid_over : &prog_wlr_solid;
+   else
+      prog = over ? &prog_wlr_tex_over : &prog_wlr_tex;
+
+   /* as opentegra's tgr3d_upload_program(), without the vertex program */
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_FP_PSEQ_DW_CFG, 1));
+   grate_stream_push(stream, TGR3D_VAL(FP_PSEQ_DW_CFG, PSEQ_TO_DW_EXEC_NB,
+                                       prog->fs_pseq_to_dw));
+
+   value  = TGR3D_VAL(ALU_BUFFER_SIZE, SIZE, prog->fs_alu_buf_size - 1);
+   value |= TGR3D_VAL(ALU_BUFFER_SIZE, SIZEx4,
+                      (pseq_cfg - 1) / (prog->fs_alu_buf_size * 4));
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_ALU_BUFFER_SIZE, 1));
+   grate_stream_push(stream, value);
+   grate_stream_push(stream, host1x_opcode_incr(0x501, 1));
+   grate_stream_push(stream, (0x2200 << 16) | (0x0032 << 16) |
+                             (pseq_cfg << 4) | 0xf);
+
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_FP_PSEQ_ENGINE_INST, 1));
+   grate_stream_push(stream, 0x20006000 | prog->fs_pseq_inst_nb);
+
+   value  = TGR3D_VAL(TRAM_SETUP, USED_TRAM_ROWS_NB, prog->used_tram_rows_nb);
+   value |= TGR3D_VAL(TRAM_SETUP, DIV64, 64 / prog->used_tram_rows_nb);
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_TRAM_SETUP, 1));
+   grate_stream_push(stream, value);
+
+   value  = TGR3D_VAL(CULL_FACE_LINKER_SETUP, UNK_18_31, 0x2e38);
+   value |= context->rast->cull_face[context->y_invert];
+   value |= TGR3D_VAL(CULL_FACE_LINKER_SETUP, LINKER_INST_COUNT,
+                      prog->linker_inst_nb - 1);
+   grate_stream_push(stream, host1x_opcode_incr(TGR3D_CULL_FACE_LINKER_SETUP, 1));
+   grate_stream_push(stream, value);
+
+   grate_stream_push(stream, host1x_opcode_imm(TGR3D_FP_PSEQ_QUAD_ID, 0));
+   grate_stream_push(stream, host1x_opcode_imm(TGR3D_FP_UPLOAD_INST_ID_COMMON, 0));
+   grate_stream_push(stream, host1x_opcode_imm(TGR3D_FP_UPLOAD_MFU_INST_ID, 0));
+   grate_stream_push(stream, host1x_opcode_imm(TGR3D_FP_UPLOAD_ALU_INST_ID, 0));
+   grate_stream_push_words(stream, prog->fs_prog_words,
+                           prog->fs_prog_words_nb, 0);
+   grate_stream_push_words(stream, prog->linker_words,
+                           prog->linker_words_nb, 0);
+
+   emit_uniforms(context, kind);
+   if (kind != GRATE_WLR_FP_SOLID)
+      emit_texture(context);
+}
diff --git a/src/gallium/drivers/grate/grate_wlr.h b/src/gallium/drivers/grate/grate_wlr.h
new file mode 100644
index 0000000..149d7ef
--- /dev/null
+++ b/src/gallium/drivers/grate/grate_wlr.h
@@ -0,0 +1,26 @@
+#ifndef GRATE_WLR_H
+#define GRATE_WLR_H
+
+#include "pipe/p_state.h"
+
+struct grate_context;
+
+/*
+ * Fragment shaders of wlroots' GLES2 renderer (and Mesa's own clear quad)
+ * that grate runs with hand-written programs from fp/wlr/, since its TGSI
+ * fragment compiler only handles MOV.
+ */
+enum grate_wlr_fp {
+   GRATE_WLR_FP_NONE = 0,
+   GRATE_WLR_FP_SOLID,     /* OUT = CONST[0] */
+   GRATE_WLR_FP_TEX,       /* OUT = TEX(IN[0]) * CONST[0].x */
+   GRATE_WLR_FP_TEX_RGBX,  /* OUT = vec4(TEX(IN[0]).rgb, 1) * CONST[0].x */
+};
+
+enum grate_wlr_fp
+grate_wlr_classify_fs(const struct tgsi_token *tokens);
+
+void
+grate_wlr_emit_program(struct grate_context *context);
+
+#endif
