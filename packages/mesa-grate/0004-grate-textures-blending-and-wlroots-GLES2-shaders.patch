diff --git a/src/gallium/drivers/grate/fp/wlr/solid.asm b/src/gallium/drivers/grate/fp/wlr/solid.asm
new file mode 100644
index 0000000..782b23c
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/wlr/solid.asm
@@ -0,0 +1,20 @@
+// gl_FragColor = colour (blending off)
+pseq_to_dw_exec_nb = 1
+alu_buffer_size = 1
+
+.asm
+
+EXEC
+	MFU:	sfu:  rcp r4
+		mul0: bar, sfu, bar0
+		mul1: bar, sfu, bar1
+		ipl:  t0.fp20, t0.fp20, NOP, NOP
+
+	ALU:
+		ALU0:	MAD  r0.l, u0.l, #1, #0
+		ALU1:	MAD  r0.h, u0.h, #1, #0
+		ALU2:	MAD  r1.l, u1.l, #1, #0
+		ALU3:	MAD  r1.h, u1.h, #1, #0
+
+	DW:	store rt1, r0, r1
+;
diff --git a/src/gallium/drivers/grate/fp/wlr/solid_over.asm b/src/gallium/drivers/grate/fp/wlr/solid_over.asm
new file mode 100644
index 0000000..dbd022a
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/wlr/solid_over.asm
@@ -0,0 +1,32 @@
+// dst = colour + dst * (1 - colour.a)   (premultiplied over)
+pseq_to_dw_exec_nb = 2
+alu_buffer_size = 1
+
+.asm
+
+EXEC
+	MFU:	sfu:  rcp r4
+		mul0: bar, sfu, bar0
+		mul1: bar, sfu, bar1
+		ipl:  t0.fp20, t0.fp20, NOP, NOP
+;
+
+EXEC
+	// fetch dst pixel to r2,r3
+	PSEQ:	0x0081000A
+
+	// tmp = -colour.a * dst + dst
+	ALU:
+		ALU0:	MAD  lp.lh, -u1.h, r2.l, r2.l
+		ALU1:	MAD  lp.lh, -u1.h, r2.h, r2.h
+		ALU2:	MAD  lp.lh, -u1.h, r3.l, r3.l
+		ALU3:	MAD  lp.lh, -u1.h, r3.h, r3.h
+
+	ALU:
+		ALU0:	MAD  r0.l, u0.l, #1, alu0 (sat)
+		ALU1:	MAD  r0.h, u0.h, #1, alu1 (sat)
+		ALU2:	MAD  r1.l, u1.l, #1, alu2 (sat)
+		ALU3:	MAD  r1.h, u1.h, #1, alu3 (sat)
+
+	DW:	store rt1, r0, r1
+;
diff --git a/src/gallium/drivers/grate/fp/wlr/tex.asm b/src/gallium/drivers/grate/fp/wlr/tex.asm
new file mode 100644
index 0000000..8dfdd02
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/wlr/tex.asm
@@ -0,0 +1,30 @@
+// gl_FragColor = texture2D(tex0, v_texcoord) * alpha (blending off)
+pseq_to_dw_exec_nb = 1
+alu_buffer_size = 1
+
+.asm
+
+EXEC
+	MFU:	sfu:  rcp r4
+		mul0: bar, sfu, bar0
+		mul1: bar, sfu, bar1
+		ipl:  t0.fp20, t0.fp20, NOP, NOP
+
+	TEX:	tex r2, r3, tex0, r0, r1, r2
+
+	ALU:
+		// a = rgbx ? 1.0 : src.a
+		ALU0:	CSEL lp.lh, -u2.l, #1, r3.h
+
+		// swap bytes 0 and 2 if needed
+		ALU1:	CSEL lp.lh, -u2.h, r3.l, r2.l
+		ALU2:	CSEL lp.lh, -u2.h, r2.l, r3.l
+
+	ALU:
+		ALU0:	MAD  r0.l, alu1, u0.l, #0
+		ALU1:	MAD  r0.h, r2.h, u0.h, #0
+		ALU2:	MAD  r1.l, alu2, u1.l, #0
+		ALU3:	MAD  r1.h, alu0, u1.h, #0
+
+	DW:	store rt1, r0, r1
+;
diff --git a/src/gallium/drivers/grate/fp/wlr/tex_over.asm b/src/gallium/drivers/grate/fp/wlr/tex_over.asm
new file mode 100644
index 0000000..15c7e2c
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/wlr/tex_over.asm
@@ -0,0 +1,49 @@
+// src = texture2D(tex0, v_texcoord) * alpha
+// dst = src + dst * (1 - src.a)   (premultiplied over)
+pseq_to_dw_exec_nb = 2
+alu_buffer_size = 1
+
+.asm
+
+EXEC
+	MFU:	sfu:  rcp r4
+		mul0: bar, sfu, bar0
+		mul1: bar, sfu, bar1
+		ipl:  t0.fp20, t0.fp20, NOP, NOP
+
+	TEX:	tex r2, r3, tex0, r0, r1, r2
+
+	ALU:
+		// a = rgbx ? 1.0 : src.a
+		ALU0:	CSEL lp.lh, -u2.l, #1, r3.h
+
+		// swap bytes 0 and 2 if needed
+		ALU1:	CSEL lp.lh, -u2.h, r3.l, r2.l
+		ALU2:	CSEL lp.lh, -u2.h, r2.l, r3.l
+
+	ALU:
+		ALU0:	MAD  r0.l, alu1, u0.l, #0
+		ALU1:	MAD  r0.h, r2.h, u0.h, #0
+		ALU2:	MAD  r1.l, alu2, u1.l, #0
+		ALU3:	MAD  r1.h, alu0, u1.h, #0
+;
+
+EXEC
+	// fetch dst pixel to r2,r3
+	PSEQ:	0x0081000A
+
+	// tmp = -src.a * dst + dst
+	ALU:
+		ALU0:	MAD  lp.lh, -r1.h, r2.l, r2.l
+		ALU1:	MAD  lp.lh, -r1.h, r2.h, r2.h
+		ALU2:	MAD  lp.lh, -r1.h, r3.l, r3.l
+		ALU3:	MAD  lp.lh, -r1.h, r3.h, r3.h
+
+	ALU:
+		ALU0:	MAD  r0.l, r0.l, #1, alu0 (sat)
+		ALU1:	MAD  r0.h, r0.h, #1, alu1 (sat)
+		ALU2:	MAD  r1.l, r1.l, #1, alu2 (sat)
+		ALU3:	MAD  r1.h, r1.h, #1, alu3 (sat)
+
+	DW:	store rt1, r0, r1
+;
