+		ALU2:	MAD  r1.l, r3.l, alu0, alu3 (sat)
+		ALU3:	MAD  r1.h, alu0, r3.h-1, #1 (sat)
 
 	DW:	store rt1, r0, r1
 ;
diff --git a/src/gallium/drivers/grate/fp/wlr/tex_rgbx.asm b/src/gallium/drivers/grate/fp/wlr/tex_rgbx.asm
new file mode 100644
index 0000000..876f2c0
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/wlr/tex_rgbx.asm
@@ -0,0 +1,22 @@
+// gl_FragColor = vec4(texture2D(tex0, v_texcoord).rgb, 1) * alpha
+pseq_to_dw_exec_nb = 1
+alu_buffer_size = 1
+
+.asm
+
+EXEC
+	MFU:	sfu:  rcp r4
+		mul0: bar, sfu, bar0
+		mul1: bar, sfu, bar1
+		ipl:  t0.fp20, t0.fp20, NOP, NOP
+
+	TEX:	tex r0, r1, tex0, r0, r1, r2
+
+	ALU:
+		ALU0:	MAD  r0.l, r0.l, u0.l, #0
+		ALU1:	MAD  r0.h, r0.h, u0.h, #0
+		ALU2:	MAD  r1.l, r1.l, u1.l, #0
+		ALU3:	MAD  r1.h, u1.h, #1, #0
+
+	DW:	store rt1, r0, r1
+;
diff --git a/src/gallium/drivers/grate/fp/wlr/tex_rgbx_over.asm b/src/gallium/drivers/grate/fp/wlr/tex_rgbx_over.asm
