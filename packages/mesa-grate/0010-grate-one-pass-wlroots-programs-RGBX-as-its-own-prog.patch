@@ -0,0 +1,31 @@
+// src = vec4(texture2D(tex0, v_texcoord).rgb, 1) * alpha
+// dst = src + dst * (1 - alpha), one pass; u2.l = 1 - alpha
+pseq_to_dw_exec_nb = 1
+alu_buffer_size = 1
+
+.asm
+
+EXEC
+	// fetch dst pixel to r2,r3; the texel goes to r0,r1
+	PSEQ:	0x0081000A
+
+	MFU:	sfu:  rcp r4
+		mul0: bar, sfu, bar0
+		mul1: bar, sfu, bar1
+		ipl:  t0.fp20, t0.fp20, NOP, NOP
+
+	TEX:	tex r0, r1, tex0, r0, r1, r2
+
+	ALU:
+		ALU0:	MAD  lp.lh, r0.l, u0.l, #0
+		ALU1:	MAD  lp.lh, r0.h, u0.h, #0
+		ALU2:	MAD  lp.lh, r1.l, u1.l, #0
+
+	ALU:
+		ALU0:	MAD  r0.l, r2.l, u2.l, alu0 (sat)
+		ALU1:	MAD  r0.h, r2.h, u2.l, alu1 (sat)
+		ALU2:	MAD  r1.l, r3.l, u2.l, alu2 (sat)
+		ALU3:	MAD  r1.h, r3.h, u2.l, u1.h (sat)
+
+	DW:	store rt1, r0, r1
+;
