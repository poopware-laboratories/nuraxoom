 .../drivers/grate/fp/wlr/solid_over.asm       |  28 +-
 src/gallium/drivers/grate/fp/wlr/tex.asm      |  18 +-
 src/gallium/drivers/grate/fp/wlr/tex_over.asm |  47 ++-
 src/gallium/drivers/grate/fp/wlr/tex_rgbx.asm |  22 ++
 .../drivers/grate/fp/wlr/tex_rgbx_over.asm    |  31 ++
 .../drivers/grate/fp/wlr/wlr_programs.h       | 272 ++++++++++++------
 src/gallium/drivers/grate/grate_wlr.c         |   7 +-
 8 files changed, 276 insertions(+), 161 deletions(-)
 create mode 100644 src/gallium/drivers/grate/fp/wlr/tex_rgbx.asm
 create mode 100644 src/gallium/drivers/grate/fp/wlr/tex_rgbx_over.asm

diff --git a/src/gallium/drivers/grate/fp/wlr/README b/src/gallium/drivers/grate/fp/wlr/README
index 7f4797b..31011ea 100644
--- a/src/gallium/drivers/grate/fp/wlr/README
+++ b/src/gallium/drivers/grate/fp/wlr/README
@@ -4,12 +4,14 @@ syntax. grate's TGSI fragment compiler only handles MOV, so
 grate_create_fs_state() recognises these TGSI shapes and uses the programs
 below instead. Tegra20 blends in the fragment program, so each comes in a
 "blending off" and a premultiplied "over" (ONE, ONE_MINUS_SRC_ALPHA) form.
+Each runs in one pass: the "over" forms fetch the destination pixel (PSEQ,
+into r2,r3) in the same EXEC that samples the texture (into r0,r1).
+Textures and render targets are both B8G8R8A8/X8 (grate samples nothing
+else), so bytes go through in memory order.
 
 Uniforms (fx10 halves, 1.0 = 256):
-  u0.l u0.h u1.l u1.h  solid: colour in render-target byte order
-                       tex:   alpha, alpha, alpha, alpha
-  u2.l                 tex: 1.0 = ignore texture alpha (RGBX)
-  u2.h                 tex: 1.0 = swap bytes 0 and 2 (RGBA texture,
-                       BGRA target or the other way round)
+  u0.l u0.h u1.l u1.h  solid: colour in render-target byte order (b g r a)
+                       tex*:  alpha, alpha, alpha, alpha
+  u2.l                 solid_over: 1 - colour.a; tex_rgbx_over: 1 - alpha
 
 Rebuild wlr_programs.h with NuraXoom's packages/mesa-grate/gen-wlr-fp.sh.
diff --git a/src/gallium/drivers/grate/fp/wlr/solid_over.asm b/src/gallium/drivers/grate/fp/wlr/solid_over.asm
index dbd022a..debd563 100644
--- a/src/gallium/drivers/grate/fp/wlr/solid_over.asm
+++ b/src/gallium/drivers/grate/fp/wlr/solid_over.asm
@@ -1,32 +1,24 @@
-// dst = colour + dst * (1 - colour.a)   (premultiplied over)
-pseq_to_dw_exec_nb = 2
+// dst = colour + dst * (1 - colour.a)   (premultiplied over), one pass
+// u2.l = 1 - colour.a, worked out on the CPU
+pseq_to_dw_exec_nb = 1
 alu_buffer_size = 1
 
 .asm
 
 EXEC
+	// fetch dst pixel to r2,r3
+	PSEQ:	0x0081000A
+
 	MFU:	sfu:  rcp r4
 		mul0: bar, sfu, bar0
 		mul1: bar, sfu, bar1
 		ipl:  t0.fp20, t0.fp20, NOP, NOP
-;
-
-EXEC
-	// fetch dst pixel to r2,r3
-	PSEQ:	0x0081000A
-
-	// tmp = -colour.a * dst + dst
-	ALU:
-		ALU0:	MAD  lp.lh, -u1.h, r2.l, r2.l
-		ALU1:	MAD  lp.lh, -u1.h, r2.h, r2.h
-		ALU2:	MAD  lp.lh, -u1.h, r3.l, r3.l
-		ALU3:	MAD  lp.lh, -u1.h, r3.h, r3.h
 
 	ALU:
-		ALU0:	MAD  r0.l, u0.l, #1, alu0 (sat)
-		ALU1:	MAD  r0.h, u0.h, #1, alu1 (sat)
-		ALU2:	MAD  r1.l, u1.l, #1, alu2 (sat)
-		ALU3:	MAD  r1.h, u1.h, #1, alu3 (sat)
+		ALU0:	MAD  r0.l, r2.l, u2.l, u0.l (sat)
+		ALU1:	MAD  r0.h, r2.h, u2.l, u0.h (sat)
+		ALU2:	MAD  r1.l, r3.l, u2.l, u1.l (sat)
+		ALU3:	MAD  r1.h, r3.h, u2.l, u1.h (sat)
 
 	DW:	store rt1, r0, r1
 ;
