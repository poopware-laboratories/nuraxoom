-		ALU2:	MAD  r1.l, alu2, u1.l, #0
-		ALU3:	MAD  r1.h, alu0, u1.h, #0
+		ALU0:	MAD  r0.l, r0.l, u0.l, #0
+		ALU1:	MAD  r0.h, r0.h, u0.h, #0
+		ALU2:	MAD  r1.l, r1.l, u1.l, #0
+		ALU3:	MAD  r1.h, r1.h, u1.h, #0
 
