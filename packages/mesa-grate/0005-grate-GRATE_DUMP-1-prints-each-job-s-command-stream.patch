From cf09742714cb18f2d15df7f89d95f1237fe63b15 Mon Sep 17 00:00:00 2001
From: s1oplus <victorgarcez@proton.me>
Date: Mon, 2 Nov 2026 18:00:00 -0300
Subject: [PATCH 5/5] grate: GRATE_DUMP=1 prints each job's command stream

For comparing grate's command streams with known-good ones.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gallium/drivers/grate/grate_stream.c | 11 +++++++++++
 src/gallium/drivers/grate/grate_stream.h |  1 +
 2 files changed, 12 insertions(+)

diff --git a/src/gallium/drivers/grate/grate_stream.c b/src/gallium/drivers/grate/grate_stream.c
index 7f594e8..a3e6bb5 100644
--- a/src/gallium/drivers/grate/grate_stream.c
+++ b/src/gallium/drivers/grate/grate_stream.c
@@ -112,6 +112,16 @@ grate_stream_flush(struct grate_stream *stream)
       goto cleanup;
    }
 
+   if (getenv("GRATE_DUMP")) {
+      uint32_t *w = stream->dump_start;
+      unsigned n = stream->buffer.pushbuf->ptr - w;
+
+      fprintf(stderr, "GRATE_DUMP job %u words\n", n);
+      for (unsigned i = 0; i < n; i++)
+         fprintf(stderr, "%08x%c", w[i], (i % 8) == 7 ? '\n' : ' ');
+      fprintf(stderr, "\nGRATE_DUMP end\n");
+   }
+
    result = drm_tegra_job_submit(stream->job, &fence);
    if (result != 0) {
       ErrorMsg("drm_tegra_job_submit() failed %d\n", result);
@@ -188,6 +198,7 @@ grate_stream_begin(struct grate_stream *stream)
 
    stream->class_id = 0;
    stream->status = GRATE_STREAM_CONSTRUCT;
+   stream->dump_start = stream->buffer.pushbuf->ptr;
 
    return 0;
 }
diff --git a/src/gallium/drivers/grate/grate_stream.h b/src/gallium/drivers/grate/grate_stream.h
index 5bfc2db..bb6fd38 100644
--- a/src/gallium/drivers/grate/grate_stream.h
+++ b/src/gallium/drivers/grate/grate_stream.h
@@ -53,6 +53,7 @@ struct grate_stream {
    struct grate_command_buffer buffer;
    int num_words;
    uint32_t class_id;
+   uint32_t *dump_start; /* GRATE_DUMP=1: print each job's words */
 };
 
 struct grate_reloc {
