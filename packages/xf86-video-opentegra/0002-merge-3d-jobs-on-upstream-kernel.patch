 {
-    /* upstream kernel driver doesn't support advanced synchronization */
-    return NULL;
+    struct tegra_stream_v1 *stream = to_stream_v1(base_stream);
+
+    /*
+     * Upstream kernel has no in-stream synchronization, so the returned
