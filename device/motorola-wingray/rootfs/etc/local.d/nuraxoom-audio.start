#!/bin/sh
# Xoom speakers: the DT routes "Int Spk" from CPCAP LINEOUT L/R; ALSA starts
# with both line-out muxes Off and the HiFi DAC at 0. Route HiFi to the
# speakers at a safe level; PipeWire/Sxmo volume keys do the rest.
for i in 1 2 3 4 5; do amixer -c 0 >/dev/null 2>&1 && break; sleep 1; done
amixer -q -c 0 sset 'Lineout Left' HiFi
amixer -q -c 0 sset 'Lineout Right' HiFi
amixer -q -c 0 sset HiFi 12
exit 0
