#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0-or-later
# Import /sdcard/NuraXoom/wifi.txt (once) and keep state dirs sane.
description="NuraXoom first boot / Wi-Fi import"
depend() { need localmount; before nuraxoom-wlan networkmanager tinydm; }
start() {
	mkdir -p /var/lib/nuraxoom
	chgrp wheel /var/lib/nuraxoom; chmod 2775 /var/lib/nuraxoom
	# No logind/pam_rundir: give each login user an XDG_RUNTIME_DIR
	awk -F: '$3 >= 1000 && $3 < 60000 {print $3":"$4}' /etc/passwd | while IFS=: read -r u g; do
		install -d -m 700 -o "$u" -g "$g" "/run/user/$u"
	done
	f=/mnt/userdata/media/0/NuraXoom/wifi.txt
	if [ -f "$f" ]; then
		ebegin "Importing Wi-Fi networks from /sdcard/NuraXoom/wifi.txt"
		/usr/libexec/nuraxoom/import-wifi "$f" && mv "$f" "$f.imported"
		eend $?
	fi
	return 0
}
